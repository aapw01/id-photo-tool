# Pixfit · environment variables
# Copy to .env.local for local overrides. All NEXT_PUBLIC_* values are
# inlined at build time, so they need to be set wherever you build, not
# just at runtime.

# --- Segmentation runtime ---

# onnxruntime-web WASM / .mjs asset host. Defaults to the pinned jsDelivr
# version (see src/features/segmentation/runtime-config.ts).
#   Production (after R2 hookup): https://cdn.pix-fit.com/ort/1.26.0/
# NEXT_PUBLIC_ORT_BASE_URL=https://cdn.jsdelivr.net/npm/onnxruntime-web@1.26.0/dist/

# MODNet ONNX model URL. Defaults to the active FP16 model on ModelScope;
# /_models/modnet.fp16.onnx remains the same-origin fallback.
# NEXT_PUBLIC_MODEL_URL=/_models/modnet.fp16.onnx

# --- Optional conversion analytics ---
# Create a GA4 web data stream and set its Measurement ID (G-XXXXXXX).
# When omitted, no Google Analytics script is loaded and tracking is a no-op.
# Only coarse conversion events are sent; photo bytes, filenames, EXIF, and
# pixel data never enter analytics payloads.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
